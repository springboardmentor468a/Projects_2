n_loader = DataLoader(train_dataset, batch_size=BATCH_SIZE, shuffle=True, num_workers=2)\nval_loader = DataLoader(val_dataset, batch_size=BATCH_SIZE, shuffle=False, num_workers=2)\n\nprint(f\"Train size: {len(train_dataset)}, Val size: {len(val_dataset)}\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-11-23T10:41:25.453055Z","iopub.execute_input":"2025-11-23T10:41:25.453429Z","iopub.status.idle":"2025-11-23T10:41:26.029404Z","shell.execute_reply.started":"2025-11-23T10:41:25.453403Z","shell.execute_reply":"2025-11-23T10:41:26.028018Z"}},"outputs":[{"name":"stdout","text":"Train size: 3200, Val size: 800\n","output_type":"stream"}],"execution_count":8},{"cell_type":"code","source":"class DoubleConv(nn.Module):\n    def __init__(self, in_ch, out_ch):\n        super().__init__()\n        self.net = nn.Sequential(\n            nn.Conv2d(in_ch, out_ch, 3, padding=1),\n            nn.ReLU(inplace=True),\n            nn.Conv2d(out_ch, out_ch, 3, padding=1),\n            nn.ReLU(inplace=True),\n        )\n    def forward(self, x):\n        return self.net(x)\n\nclass TinyUNet(nn.Module):\n    def __init__(self):\n        super().__init__()\n        self.enc1 = DoubleConv(3, 16)\n        self.enc2 = DoubleConv(16, 32)\n        self.enc3 = DoubleConv(32, 64)\n        self.pool = nn.MaxPool2d(2)\n        self.bottleneck = DoubleConv(64, 128)\n        self.up3 = nn.ConvTranspose2d(128, 64, 2, stride=2)\n        self.dec3 = DoubleConv(64+64, 64)\n        self.up2 = nn.ConvTranspose2d(64, 32, 2, stride=2)\n        self.dec2 = DoubleConv(32+32, 32)\n        self.up1 = nn.ConvTranspose2d(32, 16, 2, stride=2)\n        self.dec1 = DoubleConv(16+16, 16)\n        self.outc = nn.Conv2d(16, 1, 1)\n\n    def forward(self, x):\n        e1 = self.enc1(x)\n        e2 = self.enc2(self.pool(e1))\n        e3 = self.enc3(self.pool(e2))\n        b  = self.bottleneck(self.pool(e3))\n        d3 = self.up3(b); d3 = torch.cat([d3, e3], dim=1); d3 = self.dec3(d3)\n        d2 = self.up2(d3); d2 = torch.cat([d2, e2], dim=1); d2 = self.dec2(d2)\n        d1 = self.up1(d2); d1 = torch.cat([d1, e1], dim=1); d1 = self.dec1(d1)\n        return self.outc(d1)\n\nmodel = TinyUNet().to(DEVICE)\nprint(\"Model parameters:\", sum(p.numel() for p in model.parameters()))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-11-23T10:41:42.594635Z","iopub.execute_input":"2025-11-23T10:41:42.594954Z","iopub.status.idle":"2025-11-23T10:41:42.619836Z","shell.execute_reply.started":"2025-11-23T10:41:42.594922Z","shell.execute_reply":"2025-11-23T10:41:42.618770Z"}},"outputs":[{"name":"stdout","text":"Model parameters: 482033\n","output_type":"stream"}],"execution_count":10},{"cell_type":"code","source":"optimizer = torch.optim.Adam(model.parameters(), lr=LR)\ncriterion = nn.BCEWithLogitsLoss()\n\ndef dice_loss(pred, target, eps=1e-7):\n    pred = torch.sigmoid(pred)\n    pred_flat = pred.view(pred.shape[0], -1)\n    targ_flat = target.view(target.shape[0], -1)\n    inter = (pred_flat * targ_flat).sum(dim=1)\n    return 1 - ((2*inter + eps)/(pred_flat.sum(1)+targ_flat.sum(1)+eps)).mean()\n\ndef dice_from_logits(logits, mask):\n    return 1 - dice_loss(logits, mask)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-11-23T10:41:55.234004Z","iopub.execute_input":"2025-11-23T10:41:55.234361Z","iopub.status.idle":"2025-11-23T10:41:55.243023Z","shell.execute_reply.started":"2025-11-23T10:41:55.234336Z","shell.execute_reply":"2025-11-23T10:41:55.241825Z"}},"outputs":[],"execution_count":11},{"cell_type":"code","source":"best = 0.0\nhistory = {\"train_loss\":[], \"val_loss\":[], \"val_dice\":[]}\n\nfor epoch in range(1, EPOCHS+1):\n    t0 = time.time()\n    model.train()\n    train_loss = 0.0\n    count = 0\n    pbar = tqdm(train_loader, desc=f\"Epoch {epoch}/{EPOCHS} train\")\n    for imgs, masks in pbar:\n        imgs = imgs.to(DEVICE)\n        masks = masks.to(DEVICE)\n        optimizer.zero_grad()\n        logits = model(imgs)\n        loss = criterion(logits, masks) + dice_loss(logits, masks)\n        loss.backward()\n        optimizer.step()\n        train_loss += loss.item()\n        count += 1\n    train_loss /= max(1, count)\n    history[\"train_loss\"].append(train_loss)\n\n    # Validation\n    model.eval()\n    vloss = 0.0\n    vdice = 0.0\n    vcount = 0\n    with torch.no_grad():\n        for imgs, masks in val_loader:\n            imgs = imgs.to(DEVICE)\n            masks = masks.to(DEVICE)\n            logits = model(imgs)\n            loss = criterion(logits, masks)\n            vloss += loss.item()\n            vdice += dice_from_logits(logits, masks)\n            vcount += 1\n    val_loss = vloss / max(1,vcount)\n    val_dice = vdice / max(1,vcount)\n    history[\"val_loss\"].append(val_loss)\n    history[\"val_dice\"].append(val_dice)\n\n    print(f\"Epoch {epoch} done in {time.time()-t0:.1f}s \"\n          f\"- train_loss={train_loss:.4f} val_loss={val_loss:.4f} val_dice={val_dice:.4f}\")\n\n    if val_dice > best:\n        best = val_dice\n        torch.save(model.state_dict(), \"/kaggle/working/tiny_unet_best.pth\")\n        print(f\"Saved best model (val_dice={best:.4f})\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-11-23T10:42:08.365274Z","iopub.execute_input":"2025-11-23T10:42:08.365601Z","iopub.status.idle":"2025-11-23T10:48:45.869672Z","shell.execute_reply.started":"2025-11-23T10:42:08.365567Z","shell.execute_reply":"2025-11-23T10:48:45.868552Z"}},"outputs":[{"name":"stderr","text":"Epoch 1/2 train: 100%|██████████| 800/800 [03:00<00:00,  4.42it/s]\n","output_type":"stream"},{"name":"stdout","text":"Epoch 1 done in 197.7s - train_loss=0.2502 val_loss=0.0628 val_dice=0.9441\nSaved best model (val_dice=0.9441)\n","output_type":"stream"},{"name":"stderr","text":"Epoch 2/2 train: 100%|██████████| 800/800 [03:01<00:00,  4.42it/s]\n","output_type":"stream"},{"name":"stdout","text":"Epoch 2 done in 199.8s - train_loss=0.0825 val_loss=0.0284 val_dice=0.9731\nSaved best model (val_dice=0.9731)\n","output_type":"stream"}],"execution_count":12},{"cell_type":"code","source":"def visualize_sample(model, dataset, index=0, threshold=0.5, display_size=256):\n    model.eval()\n    img, mask = dataset[index]\n\n    with torch.no_grad():\n        logits = model(img.unsqueeze(0).to(DEVICE))\n        pred = (torch.sigmoid(logits)[0,0].cpu().numpy() > threshold).astype(np.uint8) * 255\n\n    # Original image upscaled for clarity\n    img_pil = transforms.ToPILImage()(img).resize((display_size, display_size))\n\n    # Ground truth mask as black & white\n    mask_bw = (mask[0].numpy() > 0.5).astype(np.uint8) * 255\n    mask_pil = Image.fromarray(mask_bw).resize((display_size, display_size))\n\n    # Predicted mask as black & white\n    pred_pil = Image.fromarray(pred).resize((display_size, display_size))\n\n    plt.figure(figsize=(12,4))\n    plt.subplot(1,3,1)\n    plt.imshow(img_pil)\n    plt.title(\"Original Image\")\n    plt.axis('off')\n\n    plt.subplot(1,3,2)\n    plt.imshow(mask_pil, cmap='gray')\n    plt.title(\"Ground Truth Mask\")\n    plt.axis('off')\n\n    plt.subplot(1,3,3)\n    plt.imshow(pred_pil, cmap='gray')\n    plt.title(\"Predicted Mask\")\n    plt.axis('off')\n\n    plt.show()\n\n# Example visualization\nvisualize_sample(model, val_dataset, index=5, display_size=256)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-11-23T10:49:24.202495Z","iopub.execute_input":"2025-11-23T10:49:24.202871Z","iopub.status.idle":"2025-11-23T10:49:24.713387Z","shell.execute_reply.started":"2025-11-23T10:49:24.202838Z","shell.execute_reply":"2025-11-23T10:49:24.712056Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1200x400 with 3 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":13},{"cell_type":"code","source":"def visualize_multiple(model, dataset, indices=[0,1,2,3,4], threshold=0.5, display_size=256):\n    \"\"\"\n    Display multiple samples from dataset\n    Args:\n        model : trained UNet\n        dataset : dataset object\n        indices : list of indices to visualize\n        threshold : threshold to convert logits to binary mask\n        display_size : upscaled display size\n    \"\"\"\n    model.eval()\n    n = len(indices)\n    plt.figure(figsize=(12, 4 * n))\n\n    for i, idx in enumerate(indices):\n        img, mask = dataset[idx]\n        with torch.no_grad():\n            logits = model(img.unsqueeze(0).to(DEVICE))\n            pred = (torch.sigmoid(logits)[0,0].cpu().numpy() > threshold).astype(np.uint8) * 255\n\n        img_pil = transforms.ToPILImage()(img).resize((display_size, display_size))\n        mask_bw = (mask[0].numpy() > 0.5).astype(np.uint8) * 255\n        mask_pil = Image.fromarray(mask_bw).resize((display_size, display_size))\n        pred_pil = Image.fromarray(pred).resize((display_size, display_size))\n\n        # Original\n        plt.subplot(n, 3, i*3+1)\n        plt.imshow(img_pil)\n        plt.title(f\"Original #{idx}\")\n        plt.axis('off')\n\n        # Ground Truth\n        plt.subplot(n, 3, i*3+2)\n        plt.imshow(mask_pil, cmap='gray')\n        plt.title(\"Ground Truth\")\n        plt.axis('off')\n\n        # Predicted\n        plt.subplot(n, 3, i*3+3)\n        plt.imshow(pred_pil, cmap='gray')\n        plt.title(\"Predicted\")\n        plt.axis('off')\n\n    plt.tight_layout()\n    plt.show()\n\n# Example: visualize first 5 samples\nvisualize_multiple(model, val_dataset, indices=[0,1,2,3,4], display_size=256)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-11-23T10:53:55.622946Z","iopub.execute_input":"2025-11-23T10:53:55.623354Z","iopub.status.idle":"2025-11-23T10:53:57.527362Z","shell.execute_reply.started":"2025-11-23T10:53:55.623325Z","shell.execute_reply":"2025-11-23T10:53:57.526004Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1200x2000 with 15 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":15}]}